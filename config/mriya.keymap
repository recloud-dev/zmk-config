#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT_LAYER     0
#define FUNCTIONAL_LAYER  1
#define MOUSE_LAYER       2
#define NUMBERS_LAYER     3
#define SYSTEM_LAYER      4
#define MANAGE_LAYER      5
#define MOUSE_PREC_LAYER  6
#define MOUSE_WARP_LAYER  7

/* Pointing defaults + &mmv/&msc accel + precision/warp scalers */
#include "mouse.dtsi"

#define COMBO_TERM_LONG 51

// #define HYPER <&kp LEFT_GUI &kp LEFT_ALT &kp LEFT_CONTROL &kp LEFT_SHIFT>
#define HYPER LS(LC(LG(LEFT_ALT)))
#define MEH LEFT_ALT(LC(LS))
//#define MEH <&kp LEFT_ALT &kp LEFT_CONTROL &kp LEFT_SHIFT>


#define COMBO(NAME, BINDINGS, KEYPOS, LAYERS, MS) \
    combo_##NAME { \
        bindings = <BINDINGS>; \
        key-positions = KEYPOS; \
        layers = LAYERS; \
        timeout-ms = <MS>; \
    };

&lt {
    quick-tap-ms = <200>;
};

&mt {
    quick-tap-ms = <125>;
    tapping-term-ms = <300>;
};


/ {
    combos {
        compatible = "zmk,combos";

        COMBO(caps_word, &caps_word, <12 23>, <0>, COMBO_TERM_LONG)
        COMBO(plus_symbol, &kp KP_PLUS, <7 19>, <0>, COMBO_TERM_LONG)
        COMBO(minus_symbol, &kp KP_MINUS, <19 31>, <0>, COMBO_TERM_LONG)
        COMBO(equal_with_spaces, &equal_with_spaces, <16 19>, <0>, COMBO_TERM_LONG)
        COMBO(plus_with_spaces, &plus_with_spaces, <17 19>, <0>, COMBO_TERM_LONG)
        COMBO(return, &return, <20 38>, <0>, COMBO_TERM_LONG)
        COMBO(right_arrow_with_spaces, &right_arrow_with_spaces, <19 38>, <0>, COMBO_TERM_LONG)

        COMBO(minus_with_spaces, &minus_with_spaces, <15 19>, <0>, COMBO_TERM_LONG)

        COMBO(lpar, &kp LPAR, <7 8>, <0>, COMBO_TERM_LONG)
        COMBO(rpar, &kp RPAR, <8 9>, <0>, COMBO_TERM_LONG)

        /* COMBO(change_language, &kp CAPSLOCK, <38 41>, <0>, COMBO_TERM_LONG) */
        COMBO(bracket, &kp LEFT_BRACKET, <31 32>, <0>, COMBO_TERM_LONG)
        COMBO(right_bracket, &kp RIGHT_BRACKET, <32 33>, <0>, COMBO_TERM_LONG)
        COMBO(equal_sign, &kp KP_EQUAL, <15 16>, <0>, COMBO_TERM_LONG)
        COMBO(copy, &copy, <26 27>, <0>, COMBO_TERM_LONG)
        COMBO(paste, &paste, <27 28>, <0>, COMBO_TERM_LONG)
        COMBO(cut, &cut, <26 28>, <0>, COMBO_TERM_LONG)
        COMBO(caret, &kp CARET, <6 18>, <0>, COMBO_TERM_LONG)

        COMBO(and_, &kp AMPERSAND, <9 21>, <0>, COMBO_TERM_LONG)
        COMBO(or_, &kp PIPE, <21 33>, <0>, COMBO_TERM_LONG)

        COMBO(mult, &kp KP_MULTIPLY, <8 20>, <0>, COMBO_TERM_LONG)
        COMBO(div, &kp KP_DIVIDE, <20 32>, <0>, COMBO_TERM_LONG)

        COMBO(dollar, &kp DOLLAR, <4 16>, <0>, COMBO_TERM_LONG)
        COMBO(percent, &kp PERCENT, <5 17>, <0>, COMBO_TERM_LONG)
        COMBO(tilde, &kp TILDE, <17 29>, <0>, COMBO_TERM_LONG)
        COMBO(hash, &kp HASH, <3 15>, <0>, COMBO_TERM_LONG)
        COMBO(backslash, &kp BACKSLASH, <15 27>, <0>, COMBO_TERM_LONG)
        COMBO(at, &kp AT_SIGN, <2 14>, <0>, COMBO_TERM_LONG)
        COMBO(gravis, &kp GRAVE, <13 25>, <0>, COMBO_TERM_LONG)
        COMBO(ground, &kp UNDERSCORE, <18 30>, <0>, COMBO_TERM_LONG)
        COMBO(excl, &kp EXCL, <1 13>, <0>, COMBO_TERM_LONG)
    };

    macros {
        right_arrow: right_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "RIGHT_ARROW";
        };

        move_on_word_left: move_on_word_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp LEFT_ALT>;
            label = "MOVE_ON_WORD_LEFT";
        };

        move_on_word_right: move_on_word_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp LEFT_ALT>;
            label = "MOVE_ON_WORD_RIGHT";
        };

        remove_word: remove_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp BACKSPACE>,
                <&macro_release>,
                <&kp LEFT_ALT>;
            label = "REMOVE_WORD";
        };

        right_arrow_with_spaces: right_arrow_with_spaces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp MINUS &kp GT &kp SPACE>;
            label = "RIGHT_ARROW_WITH_SPACES";
        };

        equal_with_spaces: equal_with_spaces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp KP_EQUAL &kp SPACE>;
            label = "EQUAL_WITH_SPACES";
        };

        increment_with_spaces: increment_with_spaces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp KP_PLUS &kp KP_EQUAL &kp SPACE>;
            label = "INCREMENT_WITH_SPACES";
        };

        plus_with_spaces: plus_with_spaces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp KP_PLUS &kp SPACE>;
            label = "PLUS_WITH_SPACES";
        };

        minus_with_spaces: minus_with_spaces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp KP_MINUS &kp SPACE>;
            label = "MINUS_WITH_SPACES";
        };

        copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCMD>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp LCMD>;
            label = "COPY";
        };

        paste: paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCMD>,
                <&macro_tap>,
                <&kp V>,
                <&macro_release>,
                <&kp LCMD>;
            label = "PASTE";
        };

        cut: cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCMD>,
                <&macro_tap>,
                <&kp X>,
                <&macro_release>,
                <&kp LCMD>;
            label = "CUT";
        };

        return: return {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp EQUAL &kp GT &kp SPACE>;
            label = "RETURN";
        };

        not_by_excl: not_by_excl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EXCL &kp EQUAL>;
            label = "NOT_BY_EXCL";
        };

        inc: inc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PLUS &kp EQUAL>;
            label = "INC";
        };

        decr: decr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp EQUAL>;
            label = "DECR";
        };

        ge: ge {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GT &kp EQUAL>;
            label = "GE";
        };

        le: le {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp EQUAL>;
            label = "LE";
        };

        walrus: walrus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp EQUAL>;
            label = "WALRUS";
        };

        or_pipes: or_pipes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PIPE &kp PIPE>;
            label = "OR_PIPES";
        };

        rust_lambda: rust_lambda {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PIPE &kp PIPE &kp LEFT>;
            label = "RUST_LAMBDA";
        };

        and: and {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp AMPS &kp AMPS>;
            label = "AND";
        };

        /* hyper: hyper { */
        /*     compatible = "zmk,behavior-macro"; */
        /*     #binding-cells = <0>; */
        /*     bindings = */
        /*         <&macro_press>, */
        /*         HYPER, */
        /*         <&macro_pause_for_release>, */
        /*         <&macro_release>, */
        /*         HYPER; */
        /**/
        /*     label = "HYPER_MACRO"; */
        /* }; */
        /**/
        /* meh: meh { */
        /*     compatible = "zmk,behavior-macro"; */
        /*     #binding-cells = <0>; */
        /*     bindings = */
        /*         <&macro_press>, */
        /*         MEH, */
        /*         <&macro_pause_for_release>, */
        /*         <&macro_release>, */
        /*         MEH; */
        /**/
        /*     label = "MEH_MACRO"; */
        /* }; */
    };

    behaviors {
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        /* Hold: momentary mouse (drag). Tap: toggle sticky mouse. */
        mouse_ht: mouse_ht {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSE_HT";
            #binding-cells = <2>;
            bindings = <&mo>, <&tog>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
  &none    &kp Q                &kp W                &kp E            &kp R              &kp T            &kp Y         &kp U               &kp I             &kp O             &kp P                      &none
  &kp CAPSLOCK    &hmr LEFT_CONTROL A  &hmr LEFT_ALT S      &hmr LEFT_GUI D  &hmr LEFT_SHIFT F  &hmr HYPER G            &hmr HYPER H  &hmr RIGHT_SHIFT J  &hmr RIGHT_GUI K  &hmr RIGHT_ALT L  &hmr RIGHT_CONTROL SEMI  &kp DOUBLE_QUOTES
  &none    &kp Z                &kp X                &kp C            &kp V              &kp B            &kp N         &kp M               &kp COMMA         &kp DOT           &hmr EXCL QUESTION       &none

                               &mouse_ht MOUSE_LAYER MOUSE_LAYER  &lt SYSTEM_LAYER TAB    &lt NUMBERS_LAYER SPACE    &lt FUNCTIONAL_LAYER RET        &lt FUNCTIONAL_LAYER ESCAPE  &lt NUMBERS_LAYER RETURN     &lt SYSTEM_LAYER BACKSPACE   &lt MOUSE_LAYER ESCAPE
            >;
        };

        functional_layer {
            bindings = <
  &kp F1   &kp F2   &kp F3    &kp F4   &kp F5    &kp F6     &none  &none   &none   &none   &none   &none
  &kp F7   &kp F8   &kp F9    &kp F10  &kp F11   &kp F12    &none  &trans  &trans  &trans  &trans  &none
  &kp F13  &kp F14  &kp F15   &kp F16  &kp F17   &kp F18    &none  &none   &none   &none   &none   &none
                    &trans  &none  &none  &none             &none  &none   &none   &trans
            >;
        };

        mouse_layer {
            /* Left: hold E=warp (~3x), D=precision (½x). Right: IJKL move, O/; scroll, thumbs click/tog. */
            bindings = <
  &none  &none  &mo MOUSE_WARP_LAYER  &none   &none   &none        &none  &none           &mmv MOVE_UP        &none                &msc SCRL_UP            &none
  &none  &trans &trans                &mo MOUSE_PREC_LAYER  &trans  &none        &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN      &mmv MOVE_RIGHT      &msc SCRL_DOWN          &none
  &none  &none  &none                 &none   &none   &none        &none  &msc SCRL_LEFT  &none               &msc SCRL_RIGHT      &none                   &none
              &tog MOUSE_LAYER  &trans  &trans  &trans        &mkp MB3        &mkp MB1        &mkp MB2            &tog MOUSE_LAYER
            >;
        };

        numbers_layer {
            bindings = <
  &none      &none   &none      &none       &none        &none          &remove_word           &none   &le                    &ge                   &none    &none
  &none      &none   &none      &none       &none        &none          &move_on_word_left     &none   &none                  &move_on_word_right   &none    &kp APOSTROPHE
  &trans     &kp N1  &kp N2     &kp N3      &kp N4       &kp N5         &kp N6                 &kp N7  &kp N8                 &kp N9                &kp N0   &none

                     &trans     &trans   &trans       &trans         &trans    &trans  &trans  &trans
            >;
        };

        system_layer {
            bindings = <
  &kp KP_NUM  &kp KP_SLASH     &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS    &kp K_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp PG_UP  &kp SLCK         &none
  &kp KP_N0   &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS     &kp LEFT      &kp DOWN           &kp UP           &kp RIGHT  &kp INS          &mt RCTRL K_APP
  &trans      &kp KP_N0        &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT      &kp C_VOL_DN  &kp END            &trans           &kp PG_DN  &kp PAUSE_BREAK  &trans
                               &trans     &trans     &trans     &lt MANAGE_LAYER RET       &trans     &trans             &trans           &trans
            >;
        };

        manage_layer {
            bindings = <
  &bootloader  &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &bootloader
  &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
  &sys_reset   &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &sys_reset
                             &none         &trans        &none         &trans          &trans        &none         &trans        &none
            >;
        };

        /* Mostly transparent — activates precision scaler while held with mouse keys */
        mouse_prec_layer {
            bindings = <
  &trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans

                  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans
            >;
        };

        /* Mostly transparent — activates warp scaler while held with mouse keys */
        mouse_warp_layer {
            bindings = <
  &trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans

                  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans
            >;
        };
    };
};
